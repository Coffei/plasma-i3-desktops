{
  "name": "plasma-i3-desktops",
  "private": true,
  "description": "i3-style per-monitor workspaces for KDE Plasma",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write \"**/*.{js,mjs,json}\" && node tools/format-qml.mjs",
    "format:check": "prettier --check \"**/*.{js,mjs,json}\" && node tools/format-qml.mjs --check",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\""
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
